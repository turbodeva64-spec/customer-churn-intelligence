# Database Connection Configuration
# Copy this file to .env and fill in actual connection parameters if using a remote DB.
# NEVER commit .env or actual credentials to version control.

# Supported DB_TYPE values: sqlite, postgresql, mysql, csv
DB_TYPE=sqlite

# SQLite / CSV local paths (relative to project root or absolute)
SQLITE_DB_PATH=data/raw/telco_churn.db
RAW_CSV_PATH=data/raw/Telco-Customer-Churn.csv

# Relational Database Connection Settings (used when DB_TYPE=postgresql or mysql)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=churn_intelligence_db
DB_USER=readonly_analyst
DB_PASSWORD=your_secure_password_here
DB_SCHEMA=public
DB_TABLE=customer_churn

# Model & Pipeline Configuration
RANDOM_SEED=42
TEST_SIZE=0.20
CV_FOLDS=5
RETENTION_COST_PER_CONTACT=15.0
RETENTION_SUCCESS_RATE=0.30
HORIZON_MONTHS=6
